# Dokploy: use the INTERNAL PostgreSQL connection URL. Never expose it publicly.
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/nursing_ai

# Public HTTPS origin of this application (no trailing path).
APP_URL=https://nursing.example.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google Cloud OAuth 2.0 Web application. Authorized redirect URI:
# ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Multi-Provider AI Configuration
# Primary: OpenAI
AI_PROVIDER=openai
AI_PRIMARY_PROVIDER=openai
AI_ECONOMY_PROVIDER=gemini
AI_FAST_PROVIDER=groq
AI_UTILITY_PROVIDER=cloudflare
AI_FALLBACK_ENABLED=true
ALLOW_FREE_TIER_PRIVATE_CONTENT=false

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_COMPLEX_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (Economy & Backup)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Groq Configuration (Fast Inference & Backup)
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (Utility & Scope Classifier)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CLASSIFIER_MODEL=@cf/meta/llama-3.1-8b-instruct

# Maximum sparse/scanned PDF pages sent to OpenAI Vision per uploaded file.
# Exceeding this bound fails explicitly; split the file or raise the limit.
KNOWLEDGE_MAX_OCR_PAGES=200


# SMTP enables password reset and welcome emails. For Gmail use an App Password,
# not the normal Google account password. SMTP_FROM is the visible sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
