# Dokploy: use the INTERNAL PostgreSQL connection URL. Never expose it publicly.
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/nursing_ai

# Public HTTPS origin of this application (no trailing path).
APP_URL=https://nursing.example.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google Cloud OAuth 2.0 Web application. Authorized redirect URI:
# ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One provider and one main model for every tutoring, vision and training task.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MAIN_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_SIMPLE_REASONING=low
OPENAI_NORMAL_REASONING=medium
OPENAI_COMPLEX_REASONING=high
# Temporary application rollback only; leave personal_tutor for the new architecture.
AI_ARCHITECTURE=personal_tutor
# Separate DDL account for migrations. Runtime DATABASE_URL must have no SUPERUSER/BYPASSRLS.
MIGRATION_DATABASE_URL=
# Optional LibreOffice executable for complete PPTX slide rendering.
LIBREOFFICE_PATH=

# Maximum sparse/scanned PDF pages sent to OpenAI Vision per uploaded file.
# Exceeding this bound fails explicitly; split the file or raise the limit.
KNOWLEDGE_MAX_OCR_PAGES=200


# SMTP enables password reset and welcome emails. For Gmail use an App Password,
# not the normal Google account password. SMTP_FROM is the visible sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Verified custom pg_dump receipt required before upgrading an existing database.
BACKUP_RECEIPT=
PG_DUMP_PATH=
# Optional live acceptance tests; use a dedicated enrolled staging account with sufficient quota.
EVALUATION_APP_URL=
EVALUATION_USER_EMAIL=
EVALUATION_DATASET=
EVALUATION_REVIEWS=
EVALUATION_IMAGE_PATH=
EVALUATION_PDF_PATH=
EVALUATION_E2E_REVIEWS=
EVALUATION_E2E_REPORT=
