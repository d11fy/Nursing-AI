{
  "name": "nursing-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.mjs",
    "progress:backfill": "node --conditions=react-server --import tsx scripts/backfill-learning-progress.ts",
    "knowledge:reindex": "node --conditions=react-server --import tsx scripts/reindex-knowledge.ts",
    "knowledge:restructure": "node --conditions=react-server --import tsx scripts/restructure-documents.ts",
    "evaluate:retrieval": "node --conditions=react-server --import tsx scripts/evaluate-retrieval.ts",
    "admin:promote": "node scripts/create-admin.mjs",
    "test": "node --conditions=react-server --experimental-test-module-mocks --no-warnings=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "db:backup": "node scripts/backup-database.mjs",
    "ai:preflight": "node --conditions=react-server --import tsx scripts/ai-preflight.ts",
    "evaluate:prepare": "node --conditions=react-server --import tsx scripts/prepare-tutor-evaluation.ts",
    "evaluate:tutor": "node --conditions=react-server --import tsx scripts/evaluate-tutor.ts",
    "evaluate:e2e": "node --conditions=react-server --import tsx scripts/e2e-tutor.ts",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:build:debug": "node scripts/build-android.mjs",
    "cap:build:release": "node scripts/build-android.mjs --release",
    "mobile:dev": "npm --prefix mobile run dev",
    "mobile:build": "npm --prefix mobile run build",
    "mobile:sync": "npm run mobile:build && npx cap sync android",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "db:verify-restore": "node scripts/verify-restore.mjs",
    "review:nursing": "node --import tsx scripts/nursing-review.ts",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.11",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
